{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
	  "path": "/etc/sing-box/cache.db",
      "store_fakeip": true,
      "store_rdrc": true
    },
    "clash_api": {
      "external_controller": "0.0.0.0:9090",
      "external_ui": "/etc/sing-box/ui",
      "external_ui_download_url": "https://gh-proxy.com/https://github.com/MetaCubeX/metacubexd/archive/refs/heads/gh-pages.zip",
	  "external_ui_download_detour": "direct",
	  "default_mode": "rule"
    }
  },
  "dns": {
    "independent_cache": true,
    "servers": [
      {
        "tag": "ali",
        "type": "h3",
        "server": "223.5.5.5",
		"path": "/dns-query"
      },
      {
        "tag": "fakeip",
        "type": "fakeip",
        "inet4_range": "6.0.0.0/8"
      }
    ],
    "rules": [
      {
        "clash_mode": "Direct",
        "server": "ali"
      },
      {
        "clash_mode": "Global",
        "server": "fakeip",
		"rewrite_ttl": 1
      },
      {
        "rule_set": "AWAvenue-Ads-Rule",
        "action": "reject"
      },
      {
        "rule_set": "geosite-cn",
        "server": "ali"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fakeip",
		"rewrite_ttl": 1
      }
    ]
  },
  "inbounds": [
    {
    "type": "tproxy",
    "tag": "tproxy-in",
    "listen": "0.0.0.0",
    "listen_port": 7895
    }
  ],
  "outbounds": [
    {
      "tag": "Final",
      "type": "selector",
      "outbounds": [
        "{all}"
      ]
    },
    {
      "tag": "Emby",
      "type": "selector",
      "outbounds": ["{all}"],
	  "filter": [{ "action": "include", "keywords": ["0.2X"] }, { "action": "exclude", "keywords": ["美国|日本|新加坡"] }]
    },
    {
      "tag": "giffgaff",
      "type": "selector",
      "outbounds": ["{all}"],
	  "filter": [{ "action": "include", "keywords": ["英国"] }]
    },
    {
      "tag": "ai",
      "type": "urltest",
      "outbounds": ["{all}"],
	  "filter": [{ "action": "include", "keywords": ["美国"] }],
	  "url": "http://www.gstatic.com/generate_204", 
	  "interval": "10m", 
	  "tolerance": 50
    },
    {
      "tag": "jp",
      "type": "urltest",
      "outbounds": ["{all}"],
	  "filter": [{ "action": "include", "keywords": ["日本"] }],
	  "url": "http://www.gstatic.com/generate_204", 
	  "interval": "10m", 
	  "tolerance": 50
    },
    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "route": {
    "default_domain_resolver": {
      "server": "ali"
    },
    "auto_detect_interface": true,
	"final": "Final",
	"default_mark": 666,
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "clash_mode": "Direct",
        "outbound": "direct"
      },
      {
        "clash_mode": "Global",
        "outbound": "Final"
      },
      {
        "rule_set": "AWAvenue-Ads-Rule",
        "action": "reject"
      },
	  {
		"domain_suffix": ["313445.xyz", "aikan.la", "aikan.cloud", "free.28.al"], 
		"outbound": "Emby"
	  },
	  {
		"domain_suffix": ["dmm.co.jp"], 
		"outbound": "jp"
	  },
	  {
		"domain_suffix": ["gspe1-ssl.ls.apple.com", "pub.3gppnetwork.org", "entsrv-uk.vodafone.com", "vuk-gto.prod.ondemandconnectivity.com"], 
		"ip_cidr": [
          "88.82.0.0/19",
		  "46.68.0.0/17",
		  "87.194.0.0/16"
        ],
		"outbound": "giffgaff"
	  },	  
      {
        "rule_set": "ai_non_ip",
        "outbound": "ai"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geoip-cn"
        ],
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "tag": "AWAvenue-Ads-Rule",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.github.com/TG-Twilight/AWAvenue-Ads-Rule/main/Filters/AWAvenue-Ads-Rule-Singbox-regex.srs"
      },
      {
        "tag": "ai_non_ip",
        "type": "remote",
        "format": "source",
        "url": "https://ruleset.skk.moe/sing-box/non_ip/ai.json"
      },
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.github.com/lyc8503/sing-box-rules/rule-set-geosite/geosite-cn.srs"
      },
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.github.com/lyc8503/sing-box-rules/rule-set-geoip/geoip-cn.srs"
      }
    ]
  }
}
